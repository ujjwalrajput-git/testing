import java.lang.annotation.Retention;
import java.lang.annotation.RetentionPolicy;
import java.lang.annotation.Target;
import java.lang.annotation.ElementType;
import java.lang.reflect.Method;

// Define the annotation
@Retention(RetentionPolicy.RUNTIME)
@Target(ElementType.METHOD)
@interface coforge {
    String value() default "hello";
}

// Use the annotation
public class P13_Annotation {

    @coforge(value = "this is value")
    public void show() {
        // Method logic here
    }

    public static void main(String[] args) throws Exception {
        Method method = P13_Annotation.class.getMethod("show");

        // Check if annotation is present
        if (method.isAnnotationPresent(coforge.class)) {
            coforge annotation = method.getAnnotation(coforge.class);
            System.out.println(annotation.value()); // ✅ Correct way to access value
        } else {
            System.out.println("Annotation not present.");
        }
    }
}