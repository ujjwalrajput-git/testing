package mvn1.MavenPractice;

import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import com.aventstack.extentreports.ExtentReports;
import com.aventstack.extentreports.ExtentTest;
import com.aventstack.extentreports.reporter.ExtentSparkReporter;

public class ReportExampleTest {
	
	 ExtentSparkReporter reporter;
	
	@BeforeMethod
	  public void config() {//mvn test -Pfirst
		  String path=System.getProperty("user.dir")+"\\reports\\index.html";
		  reporter=new ExtentSparkReporter(path);
		  reporter.config().setReportName("Tester: RAJAT SHUKLA");
		  reporter.config().setDocumentTitle("Smoke Tests on 5th Nov");
		  }
	 @Test
	   public void test()
	   {
		 
		 //System.out.println("hello");	
			  ExtentReports extent=new ExtentReports();
			  extent.attachReporter(reporter);
			  extent.setSystemInfo("Selenium Driver", "4");
			  extent.setSystemInfo("JDK", "15");
			  ExtentTest test=extent.createTest("Blogging sites UI test");
			  test.pass("Geeks for Geeks passed"); 
			  test.pass("Tutorialspoint passed");
			  test.pass("Javatpoint passed");
			  test.fail("Flipkart sale failed"); 
			  
			  
			  extent.flush();
			 
	   }
}
