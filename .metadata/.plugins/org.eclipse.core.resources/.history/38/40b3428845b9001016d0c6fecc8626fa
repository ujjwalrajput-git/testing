package testcases;

import org.openqa.selenium.chrome.ChromeDriver;
import org.testng.annotations.*;

public class SeleniumTest {
	ChromeDriver driver;
	void beforemethod() {
		driver = new ChromeDriver();
	}
	
	@AfterMethod
	void afterMethod() throws InterruptedException {
		Thread.sleep(3000);
		driver.close();
	}
	
	@Test
	void method() {
		driver.get("https:://www.google.com");
		Thread.sleep(3000);
		driver.close();
	}
	
}
