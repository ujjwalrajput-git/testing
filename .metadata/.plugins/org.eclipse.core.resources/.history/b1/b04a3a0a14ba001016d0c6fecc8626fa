package mvn1.MavenPractice;

import org.apache.poi.ss.usermodel.*;

import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.FileOutputStream;
import java.io.IOException;
import java.util.Iterator;

import org.apache.poi.xssf.usermodel.XSSFWorkbook;
public class ExcelReading {

    public static void main(String[] args) throws IOException {
        FileInputStream file=new FileInputStream("C:\\Users\\Ujjwal.Rajput\\Downloads\\Book1.xlsx");

        Workbook book=new XSSFWorkbook(file);
        Sheet sheet=book.getSheetAt(0);
        Iterator<Row> rows=sheet.iterator();
        while (rows.hasNext()){
            Row row=rows.next();
            Iterator<Cell> cols=row.cellIterator();
            while (cols.hasNext()){
                Cell value=cols.next();
                if(value.getCellType()== CellType.NUMERIC){
                    System.out.println((int)value.getNumericCellValue());
                }
                else{
                    System.out.println(value+" ");
                }
            }
            System.out.println();
        }
        file.close();
        FileOutputStream file2=new FileOutputStream("C:\Users\Ujjwal.Rajput\Downloads\Book1.xlsx");

        Row r1= sheet.createRow(5);
        Cell cell1=r1.createCell(0);
        cell1.setCellValue("ujjwal 01");
        Cell cell2=r1.createCell(1);
        cell2.setCellValue(22);

        book.write(file2);


    }
}
 
