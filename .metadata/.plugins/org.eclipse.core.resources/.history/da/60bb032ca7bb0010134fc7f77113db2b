package pageObjects;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;

public class BookingPage {
	WebDriver driver;
	String checkInDate="",checkInDay="";
	String checkOutDate="",checkOutDay="";
	
	By gotItBtn=By.xpath("//*[text()='Got it']");	
	By destination=By.xpath("//input[@name='query']");	
	By checkInDateBox=By.xpath("//div[text()='Check in']");	
	By guest=By.xpath("//div[text()='Who']");
	By adultCount=By.xpath("//span[@data-testid='stepper-adults-value']");
	By adultCountBtn=By.xpath("//button[@data-testid='stepper-adults-increase-button']");
	By childCountBtn=By.xpath("//button[@data-testid='stepper-children-increase-button']");
	By searchBtn=By.xpath("//button[@data-testid=\"structured-search-input-search-button\"]");
	By filterBtn=By.xpath("//button[@aria-label='Show filters']");
	By minPrice=By.id("price_filter_min");
	By maxPrice=By.id("price_filter_max");
	By showBtn=By.xpath("//a[contains(text(),'Show')]");
	By propertyAddress=By.xpath("//div[@data-testid=\"card-container\"]//span[@data-testid='listing-card-name']");
	By placesCount=By.xpath("//span[@data-testid='stays-page-heading']");
 
	public void scrollDown()
	{
		 JavascriptExecutor js=(JavascriptExecutor) driver;
		 js.executeScript("window.scrollBy(0,3000)");
	}
	public void scrollUp()
	{
		 JavascriptExecutor js=(JavascriptExecutor) driver;
		 js.executeScript("window.scrollBy(0,-3000)");
	}
	public WebElement getGotItBtn()
	{
		return this.driver.findElement(gotItBtn);
	}

	public WebElement getCheckInDateInput(String checkInDate,String checkInDay)
	{
		System.out.println("reached here");
		this.checkInDate=checkInDate.split("/")[0];
		System.out.println("Date:"+this.checkInDate);

		this.checkInDay=checkInDay;
		System.out.println("Day:"+this.checkInDay);
		
		By checkInDateInput=By.xpath("//*[contains(@aria-label,'"+this.checkInDate+", "+this.checkInDay+"')]");


		System.out.println("****in***"+checkInDateInput);
		return driver.findElement(checkInDateInput);			
	}
	public WebElement getCheckOutDateInput(String checkOutDate, String checkOutDay)
	{
		this.checkOutDate=checkOutDate.split("/")[0];
		System.out.println("Date"+this.checkOutDate);
		this.checkOutDay=checkOutDay;
		By checkOutDateInput=By.xpath("//*[contains(@aria-label,'"+this.checkOutDate+", "+this.checkOutDay+"')]");

		return this.driver.findElement(checkOutDateInput);			
	}	
	public BookingPage(WebDriver driver)
	{
		this.driver=driver;
		
	}
	public WebElement getDestination()
	{
		return this.driver.findElement(destination);
	}
	public WebElement getCheckInDateBox()
	{
		return this.driver.findElement(checkInDateBox);
	}
	
	public WebElement getGuest()
	{
		return this.driver.findElement(this.guest);			
	}
	public WebElement getAdultCount()
	{
		return this.driver.findElement(this.adultCount);			
	}
	public WebElement getAdultCountBtn()
	{
		return this.driver.findElement(this.adultCountBtn);			
	}
	public WebElement getChildCountBtn()
	{
		return this.driver.findElement(this.childCountBtn);			
	}
	public WebElement getSearchBtn()
	{
		return this.driver.findElement(this.searchBtn);			
	}
	public WebElement getFilterBtn()
	{
		return this.driver.findElement(this.filterBtn);			
	}
	public WebElement getMinPrice()
	{
		return this.driver.findElement(this.minPrice);			
	}
	public WebElement getMaxPrice()
	{
		return this.driver.findElement(this.maxPrice);			
	}
	public WebElement getShowBtn()
	{
		return this.driver.findElement(this.showBtn);			
	}
	public List<WebElement>getPropertyAddressList()
	{
		return this.driver.findElements(this.propertyAddress);			
	}
	public WebElement getplacesCount()
	{
		return this.driver.findElement(this.placesCount);			
	}

}
